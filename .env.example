# ── LLM Provider ──────────────────────────────────────────────────────────────
# Get your free key at https://console.groq.com  (sign up with email)
GROQ_API_KEY=

# Model to use. Recommended free option: llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant

# ── Superhero API ──────────────────────────────────────────────────────────────
# Sign in with GitHub at https://superheroapi.com to get your free token
SUPERHERO_API_TOKEN=

# ── Memory (conversation history) ─────────────────────────────────────────────
# Set to a Redis URL for persistent multi-worker memory.
# Leave empty to use the built-in in-memory store (single process only).
REDIS_URL=
# How long a session lives in Redis (seconds). Default: 3600 (1 hour)
SESSION_TTL_SECONDS=3600

# ── App Settings ───────────────────────────────────────────────────────────────
APP_LOG_LEVEL=INFO

# Comma-separated origins for CORS, e.g. http://localhost:3000
# Leave empty to disallow cross-origin requests
ALLOWED_ORIGINS=http://localhost:3000
